# Kết nối cơ sở dữ liệu Neon PostgreSQL (Lấy tại https://console.neon.tech)
# Khi chưa cấu hình DATABASE_URL, ứng dụng tự động lưu dữ liệu vào kho lưu trữ cục bộ (.data/family-db.json) kèm dữ liệu mẫu để dùng thử ngay!
DATABASE_URL="postgresql://neondb_owner:password@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Khóa bí mật mã hóa phiên đăng nhập JWT
JWT_SECRET="to-am-so-secret-key-2026-family-hub"

# Địa chỉ Web sau khi deploy lên Vercel (Dùng cho Android APK đồng bộ trực tiếp)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
